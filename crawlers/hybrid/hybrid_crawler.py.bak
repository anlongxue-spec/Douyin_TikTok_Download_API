# 銆€銆€銆€ 銆€銆€| 銆€_銆€ _ l\n# 銆€ 銆€銆€ 銆€锛廯 銉燂伎x銉?
# 銆€銆€ 銆€ /銆€銆€銆€ 銆€ |       Feed me Stars 猸?锔?
# 銆€銆€銆€ /銆€ 銉姐€€銆€ 锞?
# 銆€ 銆€ 鈹傘€€銆€|銆€|銆€|\n# 銆€锛忥浚|銆€銆€ |銆€|銆€|\n# 銆€| (锟ｃ兘锛縚銉絖)__)\n# 銆€锛间簩銇?
# ==============================================================================\n#\n# Contributor Link:\n# - https://github.com/Evil0ctal\n#\n# ==============================================================================\n\nimport asyncio\nimport re\nimport httpx\n\nfrom crawlers.douyin.web.web_crawler import DouyinWebCrawler  # 瀵煎叆鎶栭煶Web鐖櫕\nfrom crawlers.tiktok.web.web_crawler import TikTokWebCrawler  # 瀵煎叆TikTok Web鐖櫕\nfrom crawlers.tiktok.app.app_crawler import TikTokAPPCrawler  # 瀵煎叆TikTok App鐖櫕\nfrom crawlers.bilibili.web.web_crawler import BilibiliWebCrawler  # 瀵煎叆Bilibili Web鐖櫕\nfrom crawlers.kuaishou.web.web_crawler import KuaiShouWebCrawler  # 瀵煎叆蹇墜Web鐖櫕\n\n\nclass HybridCrawler:\n    def __init__(self):\n        self.DouyinWebCrawler = DouyinWebCrawler()\n        self.TikTokWebCrawler = TikTokWebCrawler()\n        self.TikTokAPPCrawler = TikTokAPPCrawler()\n        self.BilibiliWebCrawler = BilibiliWebCrawler()\n        self.KuaiShouWebCrawler = KuaiShouWebCrawler()\n\n    async def get_bilibili_bv_id(self, url: str) -> str:\n        """\n        浠?Bilibili URL 涓彁鍙?BV 鍙凤紝鏀寔鐭摼閲嶅畾鍚?
        """\n        # 濡傛灉鏄?b23.tv 鐭摼锛岄渶瑕侀噸瀹氬悜鑾峰彇鐪熷疄URL\n        if "b23.tv" in url:\n            async with httpx.AsyncClient() as client:\n                response = await client.head(url, follow_redirects=True)\n                url = str(response.url)\n        \n        # 浠嶶RL涓彁鍙朆V鍙?
        bv_pattern = r'(?:video\/|\/)(BV[A-Za-z0-9]+)'\n        match = re.search(bv_pattern, url)\n        if match:\n            return match.group(1)\n        else:\n            raise ValueError(f"Cannot extract BV ID from URL: {url}")\n\n    async def hybrid_parsing_single_video(self, url: str, minimal: bool = False):\n        # 瑙ｆ瀽鎶栭煶瑙嗛/Parse Douyin video\n        if "douyin" in url:\n            platform = "douyin"\n            aweme_id = await self.DouyinWebCrawler.get_aweme_id(url)\n            data = await self.DouyinWebCrawler.fetch_one_video(aweme_id)\n            data = data.get("aweme_detail")\n            # $.aweme_detail.aweme_type\n            aweme_type = data.get("aweme_type")\n        # 瑙ｆ瀽TikTok瑙嗛/Parse TikTok video\n        elif "tiktok" in url:\n            platform = "tiktok"\n            aweme_id = await self.TikTokWebCrawler.get_aweme_id(url)\n\n            # 2024-09-14: Switch to TikTokAPPCrawler instead of TikTokWebCrawler\n            # data = await self.TikTokWebCrawler.fetch_one_video(aweme_id)\n            # data = data.get("itemInfo").get("itemStruct")\n\n            data = await self.TikTokAPPCrawler.fetch_one_video(aweme_id)\n            # $.imagePost exists if aweme_type is photo\n            aweme_type = data.get("aweme_type")\n        # 瑙ｆ瀽Bilibili瑙嗛/Parse Bilibili video\n        elif "bilibili" in url or "b23.tv" in url:\n            platform = "bilibili"\n            aweme_id = await self.get_bilibili_bv_id(url)  # BV鍙蜂綔涓虹粺涓€鐨剉ideo_id\n            response = await self.BilibiliWebCrawler.fetch_one_video(aweme_id)\n            data = response.get('data', {})  # 鎻愬彇data閮ㄥ垎\n            # Bilibili鍙湁瑙嗛绫诲瀷锛宎weme_type璁句负0(video)\n            aweme_type = 0\n        # 瑙ｆ瀽蹇墜瑙嗛/Parse Kuaishou video\n        elif "kuaishou" in url:\n            platform = "kuaishou"\n            # 浣跨敤蹇墜鐖櫕鐨刦etch_video_from_url鏂规硶澶勭悊瑙嗛URL\n            response = await self.KuaiShouWebCrawler.fetch_video_from_url(url)\n            # 鎻愬彇瑙嗛鏁版嵁\n            data = response.get('data', {}).get('visionVideoDetail', {})\n            # 蹇墜瑙嗛绫诲瀷锛岃涓?(video)\n            aweme_type = 0\n        else:\n            raise ValueError("hybrid_parsing_single_video: Cannot judge the video source from the URL.")\n\n        # 妫€鏌ユ槸鍚﹂渶瑕佽繑鍥炴渶灏忔暟鎹?Check if minimal data is required\n        if not minimal:\n            return data\n\n        # 濡傛灉鏄渶灏忔暟鎹紝澶勭悊鏁版嵁/If it is minimal data, process the data\n        url_type_code_dict = {\n            # common\n            0: 'video',\n            # Douyin\n            2: 'image',\n            4: 'video',\n            68: 'image',\n            # TikTok\n            51: 'video',\n            55: 'video',\n            58: 'video',\n            61: 'video',\n            150: 'image'\n        }\n        # 鍒ゆ柇閾炬帴绫诲瀷/Judge link type\n        url_type = url_type_code_dict.get(aweme_type, 'video')\n        # print(f"url_type: {url_type}")\n\n        """\n        浠ヤ笅涓?瑙嗛||鍥剧墖)鏁版嵁澶勭悊鐨勫洓涓柟娉?濡傛灉浣犻渶瑕佽嚜瀹氫箟鏁版嵁澶勭悊璇峰湪杩欓噷淇敼.\n        The following are four methods of (video || image) data processing. \n        If you need to customize data processing, please modify it here.\n        """\n\n        """\n        鍒涘缓宸茬煡鏁版嵁瀛楀吀(绱㈠紩鐩稿悓)锛岀◢鍚庝娇鐢?update()鏂规硶鏇存柊鏁版嵁\n        Create a known data dictionary (index the same), \n        and then use the .update() method to update the data\n        """\n\n        # 鏍规嵁骞冲彴閫傞厤瀛楁鏄犲皠\n        if platform == 'bilibili':\n            result_data = {\n                'type': url_type,\n                'platform': platform,\n                'video_id': aweme_id,\n                'desc': data.get("title"),  # Bilibili浣跨敤title\n                'create_time': data.get("pubdate"),  # Bilibili浣跨敤pubdate\n                'author': data.get("owner"),  # Bilibili浣跨敤owner\n                'music': None,  # Bilibili娌℃湁闊充箰淇℃伅\n                'statistics': data.get("stat"),  # Bilibili浣跨敤stat\n                'cover_data': {},  # 灏嗗湪鍚勫钩鍙板鐞嗕腑濉厖\n                'hashtags': None,  # Bilibili娌℃湁hashtags姒傚康\n            }\n        elif platform == 'kuaishou':\n            result_data = {\n                'type': url_type,\n                'platform': platform,\n                'video_id': data.get("photoId"),  # 蹇墜浣跨敤photoId浣滀负瑙嗛ID\n                'desc': data.get("caption"),  # 蹇墜浣跨敤caption浣滀负瑙嗛鎻忚堪\n                'create_time': data.get("timestamp"),  # 蹇墜浣跨敤timestamp浣滀负鍒涘缓鏃堕棿\n                'author': data.get("author"),  # 蹇墜浣滆€呬俊鎭?
                'music': None,  # 蹇墜娌℃湁闊充箰淇℃伅\n                'statistics': data.get("stats"),  # 蹇墜浣跨敤stats浣滀负缁熻淇℃伅\n                'cover_data': {},  # 灏嗗湪鍚勫钩鍙板鐞嗕腑濉厖\n                'hashtags': None,  # 蹇墜娌℃湁hashtags姒傚康\n            }\n        else:\n            result_data = {\n                'type': url_type,\n                'platform': platform,\n                'video_id': aweme_id,  # 缁熶竴浣跨敤video_id瀛楁锛屽唴瀹瑰彲鑳芥槸aweme_id鎴朾v_id\n                'desc': data.get("desc"),\n                'create_time': data.get("create_time"),\n                'author': data.get("author"),\n                'music': data.get("music"),\n                'statistics': data.get("statistics"),\n                'cover_data': {},  # 灏嗗湪鍚勫钩鍙板鐞嗕腑濉厖\n                'hashtags': data.get('text_extra'),\n            }\n        # 鍒涘缓涓€涓┖鍙橀噺锛岀◢鍚庝娇鐢?update()鏂规硶鏇存柊鏁版嵁/Create an empty variable and use the .update() method to update the data\n        api_data = None\n        # 鍒ゆ柇閾炬帴绫诲瀷骞跺鐞嗘暟鎹?Judge link type and process data\n        # 鎶栭煶鏁版嵁澶勭悊/Douyin data processing\n        if platform == 'douyin':\n            # 濉厖灏侀潰鏁版嵁\n            result_data['cover_data'] = {\n                'cover': data.get("video", {}).get("cover"),\n                'origin_cover': data.get("video", {}).get("origin_cover"),\n                'dynamic_cover': data.get("video", {}).get("dynamic_cover")\n            }\n            # 鎶栭煶瑙嗛鏁版嵁澶勭悊/Douyin video data processing\n            if url_type == 'video':\n                # 灏嗕俊鎭偍瀛樺湪瀛楀吀涓?Store information in a dictionary\n                uri = data['video']['play_addr']['uri']\n                wm_video_url_HQ = data['video']['play_addr']['url_list'][0]\n                wm_video_url = f"https://aweme.snssdk.com/aweme/v1/playwm/?video_id={uri}&radio=1080p&line=0"\n                nwm_video_url_HQ = wm_video_url_HQ.replace('playwm', 'play')\n                nwm_video_url = f"https://aweme.snssdk.com/aweme/v1/play/?video_id={uri}&ratio=1080p&line=0"\n                api_data = {\n                    'video_data':\n                        {\n                            'wm_video_url': wm_video_url,\n                            'wm_video_url_HQ': wm_video_url_HQ,\n                            'nwm_video_url': nwm_video_url,\n                            'nwm_video_url_HQ': nwm_video_url_HQ\n                        }\n                }\n            # 鎶栭煶鍥剧墖鏁版嵁澶勭悊/Douyin image data processing\n            elif url_type == 'image':\n                # 鏃犳按鍗板浘鐗囧垪琛?No watermark image list\n                no_watermark_image_list = []\n                # 鏈夋按鍗板浘鐗囧垪琛?With watermark image list\n                watermark_image_list = []\n                # 閬嶅巻鍥剧墖鍒楄〃/Traverse image list\n                for i in data['images']:\n                    no_watermark_image_list.append(i['url_list'][0])\n                    watermark_image_list.append(i['download_url_list'][0])\n                api_data = {\n                    'image_data':\n                        {\n                            'no_watermark_image_list': no_watermark_image_list,\n                            'watermark_image_list': watermark_image_list\n                        }\n                }\n        # TikTok鏁版嵁澶勭悊/TikTok data processing\n        elif platform == 'tiktok':\n            # 濉厖灏侀潰鏁版嵁\n            result_data['cover_data'] = {\n                'cover': data.get("video", {}).get("cover"),\n                'origin_cover': data.get("video", {}).get("origin_cover"),\n                'dynamic_cover': data.get("video", {}).get("dynamic_cover")\n            }\n            # TikTok瑙嗛鏁版嵁澶勭悊/TikTok video data processing\n            if url_type == 'video':\n                # 灏嗕俊鎭偍瀛樺湪瀛楀吀涓?Store information in a dictionary\n                # wm_video = data['video']['downloadAddr']\n                # wm_video = data['video']['download_addr']['url_list'][0]\n                wm_video = (\n                    data.get('video', {})\n                    .get('download_addr', {})\n                    .get('url_list', [None])[0]\n                )\n\n                api_data = {\n                    'video_data':\n                        {\n                            'wm_video_url': wm_video,\n                            'wm_video_url_HQ': wm_video,\n                            # 'nwm_video_url': data['video']['playAddr'],\n                            'nwm_video_url': data['video']['play_addr']['url_list'][0],\n                            # 'nwm_video_url_HQ': data['video']['bitrateInfo'][0]['PlayAddr']['UrlList'][0]\n                            'nwm_video_url_HQ': data['video']['bit_rate'][0]['play_addr']['url_list'][0]\n                        }\n                }\n            # TikTok鍥剧墖鏁版嵁澶勭悊/TikTok image data processing\n            elif url_type == 'image':\n                # 鏃犳按鍗板浘鐗囧垪琛?No watermark image list\n                no_watermark_image_list = []\n                # 鏈夋按鍗板浘鐗囧垪琛?With watermark image list\n                watermark_image_list = []\n                for i in data['image_post_info']['images']:\n                    no_watermark_image_list.append(i['display_image']['url_list'][0])\n                    watermark_image_list.append(i['owner_watermark_image']['url_list'][0])\n                api_data = {\n                    'image_data':\n                        {\n                            'no_watermark_image_list': no_watermark_image_list,\n                            'watermark_image_list': watermark_image_list\n                        }\n                }\n        # Bilibili鏁版嵁澶勭悊/Bilibili data processing\n        elif platform == 'bilibili':\n            # 濉厖灏侀潰鏁版嵁\n            result_data['cover_data'] = {\n                'cover': data.get("pic"),  # Bilibili浣跨敤pic浣滀负灏侀潰\n                'origin_cover': data.get("pic"),\n                'dynamic_cover': data.get("pic")\n            }\n            # Bilibili鍙湁瑙嗛锛岀洿鎺ュ鐞嗚棰戞暟鎹?
            if url_type == 'video':\n                # 鑾峰彇瑙嗛鎾斁鍦板潃闇€瑕侀澶栬皟鐢ˋPI\n                cid = data.get('cid')  # 鑾峰彇cid\n                if cid:\n                    # 鑾峰彇鎾斁閾炬帴锛宑id闇€瑕佽浆鎹负瀛楃涓?
                    playurl_data = await self.BilibiliWebCrawler.fetch_video_playurl(aweme_id, str(cid))\n                    # 浠庢挱鏀炬暟鎹腑鎻愬彇URL\n                    dash = playurl_data.get('data', {}).get('dash', {})\n                    video_list = dash.get('video', [])\n                    audio_list = dash.get('audio', [])\n                    \n                    # 閫夋嫨鏈€楂樿川閲忕殑瑙嗛娴?
                    video_url = video_list[0].get('baseUrl') if video_list else None\n                    audio_url = audio_list[0].get('baseUrl') if audio_list else None\n                    \n                    api_data = {\n                        'video_data': {\n                            'wm_video_url': video_url,\n                            'wm_video_url_HQ': video_url,\n                            'nwm_video_url': video_url,  # Bilibili娌℃湁姘村嵃姒傚康\n                            'nwm_video_url_HQ': video_url,\n                            'audio_url': audio_url,  # Bilibili闊宠棰戝垎绂?
                            'cid': cid,  # 淇濆瓨cid渚涘悗缁娇鐢?
                        }\n                    }\n                else:\n                    api_data = {\n                        'video_data': {\n                            'wm_video_url': None,\n                            'wm_video_url_HQ': None,\n                            'nwm_video_url': None,\n                            'nwm_video_url_HQ': None,\n                            'error': 'Failed to get cid for video playback'\n                        }\n                    }\n        # 蹇墜鏁版嵁澶勭悊/Kuaishou data processing\n        elif platform == 'kuaishou':\n            # 濉厖灏侀潰鏁版嵁\n            result_data['cover_data'] = {\n                'cover': data.get("coverUrl"),  # 蹇墜浣跨敤coverUrl浣滀负灏侀潰\n                'origin_cover': data.get("coverUrl"),\n                'dynamic_cover': data.get("coverUrl")\n            }\n            # 蹇墜鍙湁瑙嗛锛岀洿鎺ュ鐞嗚棰戞暟鎹?
            if url_type == 'video':\n                # 鑾峰彇瑙嗛鎾斁鍦板潃\n                video_url = data.get('mainMvUrl')\n                if not video_url:\n                    # 灏濊瘯浠庡叾浠栧瓧娈佃幏鍙?
                    video_url = data.get('mvUrls', {}).get('urlList', [None])[0]\n                \n                api_data = {\n                    'video_data': {\n                        'wm_video_url': video_url,\n                        'wm_video_url_HQ': video_url,\n                        'nwm_video_url': video_url,  # 蹇墜娌℃湁姘村嵃姒傚康\n                        'nwm_video_url_HQ': video_url\n                    }\n                }\n        # 鏇存柊鏁版嵁/Update data\n        result_data.update(api_data)\n        return result_data\n\n    async def main(self):\n        # 娴嬭瘯娣峰悎瑙ｆ瀽鍗曚竴瑙嗛鎺ュ彛/Test hybrid parsing single video endpoint\n        # url = "https://v.douyin.com/L4FJNR3/"\n        # url = "https://www.tiktok.com/@taylorswift/video/7359655005701311786"\n        # url = "https://www.tiktok.com/@flukegk83/video/7360734489271700753"\n        # url = "https://www.tiktok.com/@minecraft/photo/7369296852669205791"\n        url = "https://v.kuaishou.com/n5T01Jd1"\n        minimal = True\n        result = await self.hybrid_parsing_single_video(url, minimal=minimal)\n        print(result)\n\n        # 鍗犱綅\n        pass\n\n\nif __name__ == '__main__':\n    # 瀹炰緥鍖栨贩鍚堢埇铏?Instantiate hybrid crawler\n    hybird_crawler = HybridCrawler()\n    # 杩愯娴嬭瘯浠ｇ爜/Run test code\n    asyncio.run(hybird_crawler.main())\n